# APAAR SETU — Backend Configuration Example
# Copy to .env and configure local values

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg2://postgres:root@127.0.0.1:5432/apaar_setu

# Cryptographic Keys (Must be 32 bytes / 256 bits for AES and HMAC)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
DATA_ENCRYPTION_KEY=change-this-to-a-secure-random-256-bit-key-for-aes256
BLIND_INDEX_SECRET_KEY=change-this-to-a-secure-random-256-bit-key-for-hmac

# JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage & Policy-Driven Retention (Milestone 3)
STORAGE_ENCRYPTION_KEY=change-this-to-a-secure-random-256-bit-key-for-storage-aes256
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_UNCOMPRESSED_ARCHIVE_BYTES=52428800
MAX_ARCHIVE_ENTRY_COUNT=500
MAX_COMPRESSION_RATIO=20
MAX_ROW_COUNT=25000
MAX_COL_COUNT=50
PARSER_TIMEOUT_SECONDS=30
RETENTION_DAYS_COMMITTED=1825
RETENTION_DAYS_CANCELLED=90


